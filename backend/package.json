  "dependencies": {
    "express": "4.18.2",
    "typeorm": "0.3.16",
    "mysql2": "3.6.0",
    "bcryptjs": "2.4.3",
    "jsonwebtoken": "9.0.2",
    "axios": "1.5.0",
    "dotenv": "16.3.1",
    "cors": "2.8.5",
    "express-validator": "7.0.0",
    "reflect-metadata": "0.1.13"
  },
  "devDependencies": {
    "@types/express": "4.17.20",
    "@types/node": "20.8.0",
    "@types/bcryptjs": "2.4.2",
    "@types/jsonwebtoken": "9.0.4",
    "@types/cors": "2.8.15",
    "typescript": "5.2.2",
    "ts-node": "10.9.1"
  }
}