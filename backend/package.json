{
  "name": "course-marketplace-backend",
  "version": "1.0.0",
  "description": "Online Course Marketplace API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
